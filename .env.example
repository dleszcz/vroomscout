# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend Email Service
RESEND_API_KEY=re_your_api_key
NOTIFICATION_EMAIL=twoj_mail@gmail.com

# Default Brand (autozglowy | zdajauto)
NEXT_PUBLIC_DEFAULT_BRAND=autozglowy

# Meta / Facebook Pixel
NEXT_PUBLIC_FACEBOOK_PIXEL_ID_AUTOZGLOWY=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID_ZDAJAUTO=
# or fallback common ID:
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
